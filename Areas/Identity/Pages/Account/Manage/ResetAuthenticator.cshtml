@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Zresetuj klucz uwierzytelniający";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Po zresetowaniu klucza aplikacja nie będzie działać do czasu ponownej konfiguracji.</strong>
    </p>
    <p>
        Ta operacja wyłącza 2FA do czasu ponownej weryfikacji aplikacji. Dokończ konfigurację, aby nie utracić dostępu do konta.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Zresetuj klucz uwierzytelniający</button>
    </form>
</div>
