@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Konfiguracja aplikacji uwierzytelniającej";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>Aby użyć aplikacji uwierzytelniającej, wykonaj poniższe kroki:</p>
    <ol class="list">
        <li>
            <p>
                Pobierz aplikację uwierzytelniającą, np. Microsoft Authenticator na
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> lub
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> albo
                Google Authenticator na
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> lub
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>Wprowadź klucz <kbd>@Model.SharedKey</kbd> do aplikacji uwierzytelniającej. Wielkość liter i spacje nie mają znaczenia.</p>
            <div class="alert alert-info">W tej wersji użyj klucza tekstowego. Generowanie kodów QR nie jest skonfigurowane.</div>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                Po wprowadzeniu klucza aplikacja wygeneruje kod. Wpisz go w polu poniżej.
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Kod weryfikacyjny"/>
                            <label asp-for="Input.Code" class="control-label form-label"></label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Zweryfikuj</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
