@page
@model Disable2faModel
@{
    ViewData["Title"] = "Wyłącz uwierzytelnianie dwuskładnikowe (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Ta operacja wyłącza tylko 2FA.</strong>
    </p>
    <p>
        Wyłączenie 2FA nie zmienia kluczy aplikacji. Aby je zmienić, <a asp-page="./ResetAuthenticator">zresetuj klucz uwierzytelniający</a>.
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Wyłącz 2FA</button>
    </form>
</div>
