@model IEnumerable<BeFit.Models.WorkoutExercise>

@{
    ViewData["Title"] = "Wykonane ćwiczenia";
}

<h1>Wykonane ćwiczenia</h1>

<p>Historia ćwiczeń wykonanych podczas Twoich treningów.</p>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Dodaj ćwiczenie
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nie masz jeszcze zapisanych ćwiczeń.
    </div>
}
else
{
    <div class="table-responsive">
<table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ExerciseTypeId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.WorkoutSessionId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Weight)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Sets)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Repetitions)
                </th>
                <th>Akcje</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ExerciseType?.Name</td>
                    <td>
                        @item.WorkoutSession?.StartTime.ToString("dd.MM.yyyy HH:mm")
                    </td>
                    <td>@item.Weight.ToString("0.##") kg</td>
                    <td>@item.Sets</td>
                    <td>@item.Repetitions</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                            Szczegóły
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Edytuj
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Usuń
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}
