@model BeFit.Models.WorkoutExerciseForm

@{
    ViewData["Title"] = "Dodaj wykonane ćwiczenie";
}

<h1>Dodaj wykonane ćwiczenie</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="WorkoutSessionId"
                       class="form-label"></label>

                <select asp-for="WorkoutSessionId"
                        asp-items="ViewBag.WorkoutSessionId"
                        class="form-select">
                    <option value="">-- Wybierz trening --</option>
                </select>

                <span asp-validation-for="WorkoutSessionId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExerciseTypeId"
                       class="form-label"></label>

                <select asp-for="ExerciseTypeId"
                        asp-items="ViewBag.ExerciseTypeId"
                        class="form-select">
                    <option value="">-- Wybierz ćwiczenie --</option>
                </select>

                <span asp-validation-for="ExerciseTypeId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Weight"
                       class="form-label"></label>

                <input asp-for="Weight"
                       type="number" step="0.01"
                       min="0" max="1000"
                       class="form-control" />

                <span asp-validation-for="Weight"
                      class="text-danger"></span>

                <div class="form-text">
                    Wpisz 0, jeśli ćwiczenie wykonujesz bez dodatkowego obciążenia.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Sets"
                       class="form-label"></label>

                <input asp-for="Sets"
                       type="number" min="1" max="100"
                       class="form-control" />

                <span asp-validation-for="Sets"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Repetitions"
                       class="form-label"></label>

                <input asp-for="Repetitions"
                       type="number" min="1" max="1000"
                       class="form-control" />

                <span asp-validation-for="Repetitions"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Dodaj ćwiczenie
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Anuluj
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
