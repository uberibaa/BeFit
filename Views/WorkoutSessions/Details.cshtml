
@model BeFit.Models.WorkoutSessionDetailsViewModel

@{
    ViewData["Title"] = "Szczegóły treningu";
}

<h1>Szczegóły treningu</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Session.StartTime)
    </dt>
    <dd class="col-sm-9">
        @Model.Session.StartTime.ToString("dd.MM.yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Session.EndTime)
    </dt>
    <dd class="col-sm-9">
        @Model.Session.EndTime.ToString("dd.MM.yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">
        Czas trwania
    </dt>
    <dd class="col-sm-9">
        @((Model.Session.EndTime - Model.Session.StartTime)
            .TotalMinutes.ToString("0")) min
    </dd>
</dl>

<hr />

<h2>Wykonane ćwiczenia</h2>

<p>
    <a asp-controller="WorkoutExercises"
       asp-action="Create"
       asp-route-sessionId="@Model.Session.Id"
       class="btn btn-primary">
        Dodaj ćwiczenie
    </a>
</p>

@if (!Model.Exercises.Any())
{
    <div class="alert alert-info">
        Nie dodano jeszcze żadnych ćwiczeń do tego treningu.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Exercises[0].ExerciseTypeId)</th>
                    <th>@Html.DisplayNameFor(model => model.Exercises[0].Weight)</th>
                    <th>@Html.DisplayNameFor(model => model.Exercises[0].Sets)</th>
                    <th>@Html.DisplayNameFor(model => model.Exercises[0].Repetitions)</th>
                    <th>Akcje</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Exercises)
                {
                    <tr>
                        <td>@item.ExerciseType?.Name</td>
                        <td>@item.Weight.ToString("0.##") kg</td>
                        <td>@item.Sets</td>
                        <td>@item.Repetitions</td>
                        <td>
                            <a asp-controller="WorkoutExercises"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                Szczegóły
                            </a>

                            <a asp-controller="WorkoutExercises"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Edytuj
                            </a>

                            <a asp-controller="WorkoutExercises"
                               asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Usuń
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<hr />

<a asp-action="Edit"
   asp-route-id="@Model.Session.Id"
   class="btn btn-warning">
    Edytuj trening
</a>

<a asp-action="Index" class="btn btn-secondary">
    Wróć do treningów
</a>
