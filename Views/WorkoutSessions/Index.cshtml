@model IEnumerable<BeFit.Models.WorkoutSession>

@{
    ViewData["Title"] = "Moje treningi";
}

<h1>Moje treningi</h1>

<p>Historia Twoich sesji treningowych.</p>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Dodaj trening
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nie masz jeszcze żadnych zapisanych treningów.
    </div>
}
else
{
    <div class="table-responsive">
<table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.StartTime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EndTime)
                </th>
                <th>Czas trwania</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.StartTime.ToString("dd.MM.yyyy HH:mm")
                    </td>
                    <td>
                        @item.EndTime.ToString("dd.MM.yyyy HH:mm")
                    </td>
                    <td>
                        @((item.EndTime - item.StartTime).TotalMinutes.ToString("0")) min
                    </td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                            Szczegóły
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Edytuj
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Usuń
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}
